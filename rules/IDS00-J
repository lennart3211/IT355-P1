/** 
* Rule: Prevent SQL injection by validating untrusted input and using parameterized 
* queries instead of directly concatenating input into SQL statements.
*
* @author: luke
*/

import java.sql.*;

public class DatabaseUtil {

    public static ResultSet authenticate(
            Connection connection,
            String username,
            String password) throws SQLException {

        String sql =
            "SELECT * FROM db_user WHERE username = ? AND password = ?";

        PreparedStatement stmt = connection.prepareStatement(sql);

        // User input is treated as data, not SQL code
        stmt.setString(1, username);
        stmt.setString(2, password);

        return stmt.executeQuery();
    }
}
